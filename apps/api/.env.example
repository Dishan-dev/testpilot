# Spring reads process environment variables; it does not auto-load this file.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/testpilot
DATABASE_USER=testpilot
DATABASE_PASSWORD=
# Exact comma-separated authorized hosts. Empty denies all targets.
AUTHORIZED_HOSTS=
# Generate distinct random secrets, at least 32 characters each.
WORKER_API_TOKEN=
ARTIFACT_SECRET=
# Relative to apps/api when started by npm run dev:api
ARTIFACTS_DIR=../../artifacts
LEASE_SECONDS=30
MAX_ATTEMPT_SECONDS=180
# Dedicated PostgreSQL database; integration tests truncate its application tables.
TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/testpilot_test
TEST_DATABASE_USER=testpilot
TEST_DATABASE_PASSWORD=
