# Exact hostnames only. Empty/missing allowlist rejects all targets.
# Add only exact hostnames you have permission to test. Empty denies execution.
AUTHORIZED_HOSTS=
WORKER_API_URL=http://127.0.0.1:8080
# Match the API's WORKER_API_TOKEN. Never use a NEXT_PUBLIC_ variable.
WORKER_API_TOKEN=
POLL_INTERVAL_MS=2000
EXECUTION_TIMEOUT_MS=120000
NAVIGATION_TIMEOUT_MS=30000
CAPTURE_TIMEOUT_MS=10000
LAUNCH_TIMEOUT_MS=30000
ARTIFACTS_DIR=artifacts
