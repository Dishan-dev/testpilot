{
  "name": "@testpilot/browser-worker",
  "version": "1.0.0",
  "description": "Independent, authorized HTTPS browser smoke testing engine",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test:url": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "service": "tsx src/service/index.ts",
    "service:start": "node dist/service/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:smoke": "node --import tsx --test test/smoke.integration.ts",
    "browsers:install": "playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
